# Only needed for command-line installs. Portainer users set these on the stack
# under "Environment variables" instead, and can skip this file entirely.
#
# DB_PASSWORD is the only value you must provide.

DB_PASSWORD=

# The published image. Point this at your own repository after the first build.
APP_IMAGE=ghcr.io/arztblut/pt/db-pt:latest

DB_NAME=personnel
DB_USER=personnel

# ---- ports -----------------------------------------------------------------
# WEB_PORT is 5060 as specified, but browsers refuse to open it: 5060 is the SIP
# port and is on the blocked-port list. Use WEB_ALT_PORT in a browser, or see
# the README. Both ports serve the same interface.
WEB_PORT=5060
WEB_ALT_PORT=8060
DB_PORT=5061

# Which interface each port listens on. The database stays on localhost unless
# you set a LAN address for DBeaver or pgAdmin.
WEB_BIND_ADDRESS=0.0.0.0
DB_BIND_ADDRESS=127.0.0.1

# ---- application -----------------------------------------------------------
APP_TITLE=Personnel Registry
ADMIN_USERNAME=admin

# Leave both blank. The app generates a session key on first start and keeps it
# in the database, and writes a generated admin password to its log.
SECRET_KEY=
ADMIN_PASSWORD=

SESSION_HOURS=12

# Set to true only when serving through an HTTPS reverse proxy.
SESSION_HTTPS_ONLY=false
